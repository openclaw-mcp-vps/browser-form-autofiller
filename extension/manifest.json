{
  "manifest_version": 3,
  "name": "browser-form-autofiller",
  "version": "1.0.0",
  "description": "Smart form filling with context awareness and profile variations.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>", "http://localhost:3000/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "browser-form-autofiller",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
